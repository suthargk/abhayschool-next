// Prisma + Supabase (Postgres): https://www.prisma.io/docs/orm/overview/databases/supabase
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EDITOR
  ADMIN
}

// Mirrors a Supabase Auth user (auth.users.id). Created manually via Prisma
// Studio after the account is created in the Supabase Auth dashboard —
// this row is what grants dashboard access and a role.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  newsNotices       NewsNotice[]
  galleryAlbums     GalleryAlbum[]
  principalMessages PrincipalMessage[]
  faculty           Faculty[]
  libraryBooks      LibraryBook[]
  academicPosts     AcademicPost[]
  toppers           Topper[]
  facilities        Facility[]
  homework          Homework[]

  @@map("profiles")
}

enum ContentType {
  NEWS
  NOTICE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentCategory {
  ACADEMIC
  ADMISSIONS
  EXAMINATION
  EVENTS
  SPORTS
  HOLIDAYS
  TRANSPORT
  PARENT_INFORMATION
  ACHIEVEMENTS
  GENERAL
}

model NewsNotice {
  id            String          @id @default(cuid())
  type          ContentType
  category      ContentCategory @default(GENERAL)
  title         String
  slug          String          @unique
  summary       String
  content       Json
  coverImageUrl String?
  status        ContentStatus   @default(DRAFT)
  pinned        Boolean         @default(false)
  featured      Boolean         @default(false)
  academicYear  String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  eventDate     DateTime?
  eventTime     String?
  venue         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  attachments Attachment[]

  @@index([status, publishedAt])
  @@index([type, status, publishedAt])
  @@index([category])
  @@index([academicYear])
  @@map("news_notices")
}

model Attachment {
  id       String  @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  newsNoticeId String
  newsNotice   NewsNotice @relation(fields: [newsNoticeId], references: [id], onDelete: Cascade)

  @@map("news_notice_attachments")
}

enum GalleryCategory {
  CAMPUS
  EVENTS
  SPORTS
  ACADEMICS
  ACTIVITIES
  CELEBRATIONS
  TRIPS
}

model GalleryAlbum {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String
  eventDate     DateTime
  coverImageUrl String?
  category      GalleryCategory @default(EVENTS)
  featured      Boolean         @default(false)
  status        ContentStatus   @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  images GalleryImage[]

  @@index([status, category, eventDate])
  @@map("gallery_albums")
}

// Singleton content: the school always has exactly one Principal's Message
// (fetched via findFirst), not a list of records.
model PrincipalMessage {
  id              String        @id @default(cuid())
  principalName   String?
  designation     String?
  quote           String?
  content         Json
  photoUrl        String?
  signatureUrl    String?
  principalSince  Int?
  experienceYears Int?
  qualification   String?
  interests       String?
  videoUrl        String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@map("principal_messages")
}

model GalleryImage {
  id       String @id @default(cuid())
  imageUrl String
  position Int    @default(0)

  albumId String       @map("album_id")
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, position])
  @@map("gallery_images")
}

enum FacultyCategory {
  LEADERSHIP
  TEACHING
  SUPPORT
}

model Faculty {
  id              String          @id @default(cuid())
  name            String
  designation     String
  department      String?
  category        FacultyCategory @default(TEACHING)
  subjects        String[]        @default([])
  grades          String[]        @default([])
  areasOfInterest String[]        @default([])
  achievements    String[]        @default([])
  qualification   String?
  bio             String?
  experienceYears Int?
  email           String?
  photoUrl        String?
  position        Int             @default(0)
  status          ContentStatus   @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, position])
  @@index([status, category, position])
  @@map("faculty")
}

enum LibraryClass {
  CLASS_I
  CLASS_II
  CLASS_III
  CLASS_IV
  CLASS_V
  CLASS_VI
  CLASS_VII
  CLASS_VIII
  CLASS_IX
  CLASS_X
  CLASS_XI
  CLASS_XII
}

model LibraryBook {
  id          String        @id @default(cuid())
  class       LibraryClass
  bookName    String
  subject     String
  publication String
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([class, status, position])
  @@map("library_books")
}

model Homework {
  id           String        @id @default(cuid())
  class        LibraryClass
  subject      String
  title        String
  content      Json
  teacherName  String?
  status       ContentStatus @default(DRAFT)
  assignedDate DateTime
  dueDate      DateTime
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  attachments HomeworkAttachment[]

  @@index([status, dueDate])
  @@index([class, subject, status])
  @@map("homework")
}

model HomeworkAttachment {
  id       String  @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@map("homework_attachments")
}

model AcademicPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  content       Json
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@map("academic_posts")
}

enum TopperClass {
  CLASS_X
  CLASS_XII
}

enum Stream {
  SCIENCE
  COMMERCE
  ARTS
}

model Topper {
  id            String        @id @default(cuid())
  name          String
  class         TopperClass
  stream        Stream?
  year          Int
  rank          Int           @default(1)
  percentage    Float
  marksObtained Int?
  marksTotal    Int?
  photoUrl      String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, year])
  @@index([class, year, rank])
  @@map("toppers")
}

enum FacilitySection {
  OVERVIEW
  SPORTS
  SAFETY
  FAQ
}

// A single model backs four sections of the public Facilities page,
// distinguished by `section`. Field meaning shifts per section: for FAQ,
// `title`/`summary` hold the question/answer; for OVERVIEW, `featured`
// picks the subset shown in the large alternating "Featured Facilities"
// blocks (using `description` and `imageUrl`).
model Facility {
  id          String          @id @default(cuid())
  section     FacilitySection @default(OVERVIEW)
  icon        String?
  title       String
  summary     String?
  description String?
  imageUrl    String?
  featured    Boolean         @default(false)
  position    Int             @default(0)
  status      ContentStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([section, status, position])
  @@map("facilities")
}

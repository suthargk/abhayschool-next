// Prisma + Supabase (Postgres): https://www.prisma.io/docs/orm/overview/databases/supabase
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EDITOR
  ADMIN
  TEACHER
}

// Only meaningful for TEACHER profiles: ADMIN/EDITOR rows created via Prisma
// Studio stay ACTIVE. A teacher who self-signs-up starts PENDING until an
// admin approves them in the super-admin dashboard; REJECTED revokes access.
enum ProfileStatus {
  ACTIVE
  PENDING
  REJECTED
}

// Mirrors a Supabase Auth user (auth.users.id). ADMIN/EDITOR rows are created
// manually via Prisma Studio after the account is created in the Supabase
// Auth dashboard. TEACHER rows are created by the self-serve signup flow
// (src/app/api/teacher/verify-otp) after the teacher verifies the OTP emailed
// to their school address — this row is what grants dashboard access and a
// role.
model Profile {
  id        String        @id @db.Uuid
  email     String        @unique
  role      Role          @default(EDITOR)
  status    ProfileStatus @default(ACTIVE)
  firstName String?
  lastName  String?
  phone     String?
  photoUrl  String?
  createdAt DateTime      @default(now())

  newsNotices        NewsNotice[]
  galleryAlbums      GalleryAlbum[]
  principalMessages  PrincipalMessage[]
  faculty            Faculty[]
  libraryBooks       LibraryBook[]
  academicPosts      AcademicPost[]
  toppers            Topper[]
  facilities         Facility[]
  homework           Homework[]
  faqs               Faq[]
  testimonials       Testimonial[]
  timeTableSlots     TimeTableSlot[]
  schoolClasses      SchoolClass[]
  teacherAssignments TeacherAssignment[]

  @@map("profiles")
}

// Which class+subject combinations a TEACHER profile is allowed to post
// homework for, set by an admin from the super-admin teacher-approval page.
model TeacherAssignment {
  id        String   @id @default(cuid())
  class     String
  subject   String
  createdAt DateTime @default(now())

  teacherId String  @db.Uuid
  teacher   Profile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, class, subject])
  @@map("teacher_assignments")
}

// Short-lived record backing teacher email verification. Holds the signup
// form data (password encrypted at rest, see src/lib/otp.js) until the OTP
// is verified — no Supabase Auth user and no Profile are created until then,
// so an unverified signup never reaches auth.users. Consumed by
// /api/teacher/verify-otp, which creates the Auth user and Profile together.
// One pending signup per email; re-signing up before verifying replaces the
// row (see /api/teacher/signup).
model TeacherSignupOtp {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String
  lastName    String
  phone       String
  photoUrl    String?
  passwordEnc String
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("teacher_signup_otps")
}

enum ContentType {
  NEWS
  NOTICE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentCategory {
  ACADEMIC
  ADMISSIONS
  EXAMINATION
  EVENTS
  SPORTS
  HOLIDAYS
  TRANSPORT
  PARENT_INFORMATION
  ACHIEVEMENTS
  GENERAL
}

model NewsNotice {
  id            String          @id @default(cuid())
  type          ContentType
  category      ContentCategory @default(GENERAL)
  title         String
  slug          String          @unique
  summary       String
  content       Json
  coverImageUrl String?
  status        ContentStatus   @default(DRAFT)
  pinned        Boolean         @default(false)
  featured      Boolean         @default(false)
  academicYear  String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  eventDate     DateTime?
  eventTime     String?
  venue         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  attachments Attachment[]

  @@index([status, publishedAt])
  @@index([type, status, publishedAt])
  @@index([category])
  @@index([academicYear])
  @@map("news_notices")
}

model Attachment {
  id       String  @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  newsNoticeId String
  newsNotice   NewsNotice @relation(fields: [newsNoticeId], references: [id], onDelete: Cascade)

  @@map("news_notice_attachments")
}

enum GalleryCategory {
  CAMPUS
  EVENTS
  SPORTS
  ACADEMICS
  ACTIVITIES
  CELEBRATIONS
  TRIPS
}

model GalleryAlbum {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String
  eventDate     DateTime
  coverImageUrl String?
  category      GalleryCategory @default(EVENTS)
  featured      Boolean         @default(false)
  status        ContentStatus   @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  images GalleryImage[]

  @@index([status, category, eventDate])
  @@map("gallery_albums")
}

// Singleton content: the school always has exactly one Principal's Message
// (fetched via findFirst), not a list of records.
model PrincipalMessage {
  id              String        @id @default(cuid())
  principalName   String?
  designation     String?
  quote           String?
  content         Json
  photoUrl        String?
  signatureUrl    String?
  principalSince  Int?
  experienceYears Int?
  qualification   String?
  interests       String?
  videoUrl        String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@map("principal_messages")
}

model GalleryImage {
  id       String @id @default(cuid())
  imageUrl String
  position Int    @default(0)

  albumId String       @map("album_id")
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, position])
  @@map("gallery_images")
}

enum FacultyCategory {
  LEADERSHIP
  TEACHING
  SUPPORT
}

model Faculty {
  id              String          @id @default(cuid())
  name            String
  designation     String
  department      String?
  category        FacultyCategory @default(TEACHING)
  subjects        String[]        @default([])
  grades          String[]        @default([])
  areasOfInterest String[]        @default([])
  achievements    String[]        @default([])
  qualification   String?
  bio             String?
  experienceYears Int?
  email           String?
  photoUrl        String?
  position        Int             @default(0)
  status          ContentStatus   @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, position])
  @@index([status, category, position])
  @@map("faculty")
}

// Admin-managed list of school classes/grades (e.g. "Class I", "Nursery").
// `value` is a stable, immutable identifier stored on content records
// (LibraryBook.class, Homework.class, TimeTableSlot.class); `label` is the
// editable display name, so renaming a class here updates it everywhere
// without touching existing content rows.
model SchoolClass {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@map("school_classes")
}

model LibraryBook {
  id          String        @id @default(cuid())
  class       String
  bookName    String
  subject     String
  publication String
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([class, status, position])
  @@map("library_books")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model TimeTableSlot {
  id          String        @id @default(cuid())
  class       String
  day         Weekday
  period      Int
  subject     String
  teacherName String?
  startTime   String?
  endTime     String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@unique([class, day, period])
  @@index([class, status])
  @@map("time_table_slots")
}

model Homework {
  id           String        @id @default(cuid())
  class        String
  subject      String
  title        String
  content      Json
  teacherName  String?
  status       ContentStatus @default(DRAFT)
  assignedDate DateTime
  dueDate      DateTime
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  attachments HomeworkAttachment[]

  @@index([status, dueDate])
  @@index([class, subject, status])
  @@map("homework")
}

model HomeworkAttachment {
  id       String  @id @default(cuid())
  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@map("homework_attachments")
}

model AcademicPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  content       Json
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@map("academic_posts")
}

enum TopperClass {
  CLASS_X
  CLASS_XII
}

enum Stream {
  SCIENCE
  COMMERCE
  ARTS
}

model Topper {
  id            String        @id @default(cuid())
  name          String
  class         TopperClass
  stream        Stream?
  year          Int
  rank          Int           @default(1)
  percentage    Float
  marksObtained Int?
  marksTotal    Int?
  photoUrl      String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, year])
  @@index([class, year, rank])
  @@map("toppers")
}

enum FacilitySection {
  OVERVIEW
  SPORTS
  SAFETY
  FAQ
}

// A single model backs four sections of the public Facilities page,
// distinguished by `section`. Field meaning shifts per section: for FAQ,
// `title`/`summary` hold the question/answer; for OVERVIEW, `featured`
// picks the subset shown in the large alternating "Featured Facilities"
// blocks (using `description` and `imageUrl`).
model Facility {
  id          String          @id @default(cuid())
  section     FacilitySection @default(OVERVIEW)
  icon        String?
  title       String
  summary     String?
  description String?
  imageUrl    String?
  featured    Boolean         @default(false)
  position    Int             @default(0)
  status      ContentStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([section, status, position])
  @@map("facilities")
}

// Homepage "Frequently Asked Questions" section.
model Faq {
  id          String        @id @default(cuid())
  question    String
  answer      String
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, position])
  @@map("faqs")
}

enum AdmissionStatus {
  NEW
  CONTACTED
  CLOSED
}

// Public admission enquiries submitted from the website's "Apply for
// Admission" form. Purely inbound (no author) — reviewed by an admin who
// moves it through the status lifecycle. `status: NEW` doubles as the
// "unread" flag shown in the admin panel notification badge.
model AdmissionEnquiry {
  id              String          @id @default(cuid())
  studentName     String
  dateOfBirth     DateTime?
  gender          String?
  classAppliedFor String
  parentName      String
  phone           String
  email           String?
  address         String?
  previousSchool  String?
  message         String?
  status          AdmissionStatus @default(NEW)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, createdAt])
  @@map("admission_enquiries")
}

enum TestimonialSource {
  ADMIN
  PARENT
}

// Homepage "Testimonials" marquee section. Parent-submitted testimonials
// (source: PARENT) come in as DRAFT via the public OTP-verified form and
// have no author profile; they wait for an admin to review and publish.
model Testimonial {
  id          String            @id @default(cuid())
  name        String
  designation String?
  quote       String
  photoUrl    String?
  phone       String?
  source      TestimonialSource @default(ADMIN)
  position    Int               @default(0)
  status      ContentStatus     @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  authorId String?  @db.Uuid
  author   Profile? @relation(fields: [authorId], references: [id])

  @@index([status, position])
  @@map("testimonials")
}

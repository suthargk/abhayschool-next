// Prisma + Supabase (Postgres): https://www.prisma.io/docs/orm/overview/databases/supabase
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EDITOR
  ADMIN
}

// Mirrors a Supabase Auth user (auth.users.id). Created manually via Prisma
// Studio after the account is created in the Supabase Auth dashboard —
// this row is what grants dashboard access and a role.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  newsNotices       NewsNotice[]
  galleryAlbums     GalleryAlbum[]
  principalMessages PrincipalMessage[]
  faculty           Faculty[]
  libraryBooks      LibraryBook[]
  academicPosts     AcademicPost[]

  @@map("profiles")
}

enum ContentType {
  NEWS
  NOTICE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model NewsNotice {
  id            String        @id @default(cuid())
  type          ContentType
  title         String
  slug          String        @unique
  summary       String
  content       Json
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@index([type, status, publishedAt])
  @@map("news_notices")
}

model GalleryAlbum {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String
  eventDate     DateTime
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  images GalleryImage[]

  @@index([status, eventDate])
  @@map("gallery_albums")
}

// Singleton content: the school always has exactly one Principal's Message
// (fetched via findFirst), not a list of records.
model PrincipalMessage {
  id            String        @id @default(cuid())
  principalName String?
  content       Json
  photoUrl      String?
  signatureUrl  String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@map("principal_messages")
}

model GalleryImage {
  id       String @id @default(cuid())
  imageUrl String
  position Int    @default(0)

  albumId String       @map("album_id")
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, position])
  @@map("gallery_images")
}

model Faculty {
  id              String        @id @default(cuid())
  name            String
  designation     String
  department      String?
  subjects        String[]      @default([])
  qualification   String?
  bio             String?
  experienceYears Int?
  email           String?
  photoUrl        String?
  position        Int           @default(0)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, position])
  @@map("faculty")
}

enum LibraryClass {
  CLASS_I
  CLASS_II
  CLASS_III
  CLASS_IV
  CLASS_V
  CLASS_VI
  CLASS_VII
  CLASS_VIII
  CLASS_IX
  CLASS_X
  CLASS_XI
  CLASS_XII
}

model LibraryBook {
  id          String        @id @default(cuid())
  class       LibraryClass
  bookName    String
  subject     String
  publication String
  position    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([class, status, position])
  @@map("library_books")
}

model AcademicPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  content       Json
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorId String  @db.Uuid
  author   Profile @relation(fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@map("academic_posts")
}

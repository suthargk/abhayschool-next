# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Prisma — Project Settings → Database → Connection string (URI)
# DATABASE_URL: use the pooler / "Transaction" mode (often port 6543 + ?pgbouncer=true).
# connection_limit/pool_timeout are set explicitly because Vercel serverless functions
# report very few CPUs, so Prisma's auto-computed default (cpus*2+1) ends up too small
# (often just 3) for pages that fire several concurrent queries via Promise.all — that
# undersized pool is what causes "Timed out fetching a new connection from the pool."
# Safe to raise here since Supavisor (the pooler) cheaply multiplexes these onto a small
# number of real Postgres backend connections.
# DIRECT_URL: use direct / "Session" connection for migrations (port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# MSG91 OTP — used to verify a parent's phone number before their public
# testimonial submission is accepted (control.msg91.com → OTP → Widget/API,
# and a DLT-approved OTP template ID for Indian numbers)
MSG91_AUTH_KEY="560728AOu6NTnwy6a7f6702P1"
MSG91_TEMPLATE_ID="6a7f685155509fecbd0a8752"

# Amazon S3 — file/image storage (IAM user scoped to this bucket only)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET_NAME="your-bucket-name"

# SMTP — used to email the school office when a public admission enquiry is
# submitted (e.g. Gmail with an App Password, Zoho Mail, or any SMTP relay)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password-or-app-password"
SMTP_FROM="Shri Abhay Nobles School Website <no-reply@shriabhaynoblesschool.com>"

# Where new admission enquiries are emailed
ADMISSIONS_NOTIFY_EMAIL="admin@shriabhaynoblesschool.com"
